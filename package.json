{
  "name": "rtbc-orders-qa-mcp",
  "version": "0.0.0",
  "description": "Servidor MCP con herramientas deterministas de análisis de calidad para rtbc-orders-api",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1",
    "yaml": "2.9.1"
  }
}
